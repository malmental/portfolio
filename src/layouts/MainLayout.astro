---
/**
 * =============================================================================
 * MAINLAYOUT.ASTRO - BASE HTML DOCUMENT SHELL
 * =============================================================================
 *
 * PURPOSE:
 *   Serves as the foundational HTML wrapper for ALL pages in the portfolio.
 *   This layout is inherited by every page component and provides the base
 *   document structure, meta tags, font loading, and global styles.
 *
 * PORTFOLIO USE CASE:
 *   - This file is rarely modified directly
 *   - Instead, individual pages pass their own title/description via props
 *   - The Navbar and Footer are NOT included here; they're imported per-page
 *     to allow flexibility in placement and behavior
 *
 * KEY FEATURES:
 *   1. Poppins font family (weights 100-900) loaded via @fontsource
 *   2. Astro View Transitions support (configurable via isTransitionEnabled)
 *   3. Global CSS imports (styles.css for base styling)
 *   4. SEO meta tags (description, generator, sitemap)
 *   5. Responsive viewport meta tag
 *
 * PROPS ACCEPTED:
 *   - title (string): Page title, defaults to 'Salem'
 *   - description (string): Meta description, used for SEO
 *
 * MODIFICATION NOTES:
 *   - To change the font: modify the Google Fonts link above
 *   - To disable view transitions: set isTransitionEnabled = false in data.js
 */
import { isTransitionEnabled } from "../data";
import "../styles/styles.css";
import { ViewTransitions } from "astro:transitions";

const { title = "Salem.Dev", description = "Portfolio of Salem - Developer" } =
  Astro.props;
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Google+Sans+Code:ital,wght@0,300..800;1,300..800&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
    {isTransitionEnabled && <ViewTransitions />}
    <script is:inline>
      const savedTheme = localStorage.getItem('theme-mode');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const initialTheme = savedTheme || (prefersDark ? 'dark' : 'light');
      document.documentElement.dataset.theme = initialTheme;
    </script>
  </head>
  <body>
    <button
      type="button"
      class="theme-toggle"
      aria-label="Toggle color theme"
      data-theme-toggle
    >
      <span data-theme-icon class="theme-icon"></span>
    </button>
    <div class="site-shell">
      <slot />
    </div>
    <script>
      const lightModeSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><title xmlns="">baseline-light-mode</title><path fill="currentColor" d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5s5-2.24 5-5s-2.24-5-5-5M2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1m18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1M11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1m0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1M5.99 4.58a.996.996 0 0 0-1.41 0a.996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41zm12.37 12.37a.996.996 0 0 0-1.41 0a.996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0a.996.996 0 0 0 0-1.41zm1.06-10.96a.996.996 0 0 0 0-1.41a.996.996 0 0 0-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0zM7.05 18.36a.996.996 0 0 0 0-1.41a.996.996 0 0 0-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0z"/></svg>`;
      const darkModeSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><title xmlns="">dark-mode-rounded</title><path fill="currentColor" d="M12 21q-3.775 0-6.387-2.613T3 12q0-3.45 2.25-5.988T11 3.05q.325-.05.575.088t.4.362t.163.525t-.188.575q-.425.65-.638 1.375T11.1 7.5q0 2.25 1.575 3.825T16.5 12.9q.775 0 1.538-.225t1.362-.625q.275-.175.563-.162t.512.137q.25.125.388.375t.087.6q-.35 3.45-2.937 5.725T12 21"/></svg>`;

      const root = document.documentElement;
      const themeToggle = document.querySelector("[data-theme-toggle]");
      const themeIcon = document.querySelector("[data-theme-icon]");

      const syncThemeUi = () => {
        const isDark = root.dataset.theme === "dark";
        if (themeIcon) {
          themeIcon.innerHTML = isDark ? lightModeSvg : darkModeSvg;
        }
      };

      syncThemeUi();

      themeToggle?.addEventListener("click", () => {
        const nextTheme = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = nextTheme;
        localStorage.setItem("theme-mode", nextTheme);
        syncThemeUi();
      });

      const observerOptions = {
        root: null,
        rootMargin: "0px 0px -80px 0px",
        threshold: 0.1,
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
          }
        });
      }, observerOptions);

      document.addEventListener("DOMContentLoaded", () => {
        const animatedElements = document.querySelectorAll(".animate-on-scroll");
        animatedElements.forEach((el) => observer.observe(el));
      });
    </script>
  </body>
</html>
