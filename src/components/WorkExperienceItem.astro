---
/**
 * =============================================================================
 * WORKEXPERIENCEITEM.ASTRO - INDIVIDUAL EXPERIENCE ENTRY
 * =============================================================================
 *
 * PURPOSE:
 *   Renders a single work experience entry with company name, position title,
 *   date range, and achievement bullet points. Part of the WorkExperienceBox
 *   container.
 *
 * PORTFOLIO USE CASE:
 *   - Displays one professional experience entry
 *   - Shows role, company, timeframe, and key achievements
 *   - Hover state provides interactive feedback
 *
 * PROPS:
 *   - workExperience: Object {
 *       organisationName: string,
 *       position: string,
 *       date: string,
 *       info: string[]
 *     }
 *
 * LAYOUT:
 *   - Header row: Company name + position (left), date (right)
 *   - Bullet points: Achievements/responsibilities list below header
 *
 * HOVER STATES:
 *   - Text color: text-slate-500 → text-black
 *   - Border: transparent → border-b-2 (black)
 *   - Date color: text-slate-600 → text-black
 *
 * MODIFICATION NOTES:
 *   - To change bullet style: modify list-disc (currently disc/bullet)
 *   - To add more fields: extend the workExperience object
 *   - To change date position: reorder flex container contents
 */

const { workExperience } = Astro.props;
---

<div
  class='group cursor-pointer flex flex-col w-full p-5 transition duration-300 text-slate-500 group hover:text-black border-b-2 hover:border-black'
>
  <div class='flex justify-between items-center'>
    <div class='flex flex-col gap-1'>
      <span class='font-bold'>{workExperience.organisationName} </span>
      <span class='font-light text-xs text-slate-600'
        >{workExperience.position}</span
      >
    </div>
    <span class='font-light text-sm text-slate-600 group-hover:text-black'
      >{workExperience.date}</span>
  </div>
  <ul class='mt-1 p-2 ml-3 list-disc'>
    {workExperience.info.map((info) => <li>{info}</li>)}
  </ul>
</div>
