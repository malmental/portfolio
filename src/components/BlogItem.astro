---
/**
 * =============================================================================
 * BLOGITEM.ASTRO - BLOG POST PREVIEW CARD
 * =============================================================================
 *
 * PURPOSE:
 *   Renders a single blog post preview item for use in blog listing pages
 *   (blog.astro) and blog preview sections (BlogSection). Displays title,
 *   truncated description, publication date, and external link arrow.
 *
 * PORTFOLIO USE CASE:
 *   - Used in the /blog listing grid (3 columns desktop)
 *   - Used in BlogSection sidebar (5 most recent posts)
 *   - Provides clickable preview cards that link to full posts
 *
 * PROPS:
 *   - post: Astro.glob result object with frontmatter properties:
 *       - title: string (post title)
 *       - description: string (truncated at 50 chars)
 *       - pubDate: string (publication date)
 *       - url: string (auto-generated by Astro for routing)
 *
 * FEATURES:
 *   - Title with external link icon (appears on hover)
 *   - Description truncated to 50 characters with "..."
 *   - Publication date displayed
 *   - Full row is clickable
 *
 * HOVER STATES:
 *   - Text color: text-slate-500 → text-black
 *   - Border: transparent → border-b-2 (black)
 *   - Arrow SVG: hidden → block (group-hover:block)
 *   - Date color: text-slate-500 → text-black
 *
 * MODIFICATION NOTES:
 *   - To change truncation length: modify description.length > 50 condition
 *   - To hide description: conditionally hide <p> element based on frontmatter
 *   - To add categories/tags: extend with post.frontmatter.tags
 */

const { post } = Astro.props;
---

<a
  href={post.url}
  class='group cursor-pointer flex flex-col w-full p-5 transition duration-300 text-slate-500 group hover:text-black border-b-2 hover:border-black'
>
  <div>
    <div class='flex items-center w-full gap-2'>
      <span class='font-bold'>{post.frontmatter.title} </span>
      <svg
        xmlns='http://www.w3.org/2000/svg'
        fill='none'
        viewBox='0 0 24 24'
        stroke-width='1.5'
        stroke='currentColor'
        class='size-4 hidden group-hover:block transition duration-0'
      >
        <path
          stroke-linecap='round'
          stroke-linejoin='round'
          d='m4.5 19.5 15-15m0 0H8.25m11.25 0v11.25'></path>
      </svg>
    </div>
  </div>
  <p class='mt-2'>
    {
      post.frontmatter.description
        ? post.frontmatter.description.length > 50
          ? post.frontmatter.description.substr(0, 50) + '...'
          : post.frontmatter.description
        : ''
    }
  </p>
  <span
    class='mt-2 font-light text-[12px] text-slate-500 group-hover:text-black'
    >{post.frontmatter.pubDate}</span
  >
</a>
