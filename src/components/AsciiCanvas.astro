---
const {
  gifSources = ['/gif/Cube-shape animation-2.gif'],
  desktopWidth = 'min(100%, 52rem)',
  desktopMinHeight = '36rem',
  desktopFontSize = 'clamp(0.62rem, 1vw, 0.88rem)',
  className = '',
} = Astro.props;

// Map GIF source paths to their pre-computed ASCII frame JSON files
function getAsciiFramePaths(gifSource) {
  const baseName = gifSource.split('/').pop().replace(/\s+/g, '-').replace(/\.gif$/, '');
  return {
    desktop: `/ascii-frames/${baseName}.json`,
    mobile: `/ascii-frames/${baseName}-mobile.json`,
  };
}

const framePaths = gifSources.map((src) => getAsciiFramePaths(src));
---

<div
  class:list={['ascii-canvas-shell', className]}
  data-ascii-canvas
  data-frame-paths={JSON.stringify(framePaths)}
  style={`--ascii-desktop-width:${desktopWidth};--ascii-desktop-min-height:${desktopMinHeight};--ascii-desktop-font-size:${desktopFontSize};`}
>
  <pre class="ascii-output" aria-label="Animated ASCII artwork"></pre>
</div>

<script is:inline>
  (function() {
    var canvases = document.querySelectorAll('[data-ascii-canvas]');

    canvases.forEach(function(root) {
      if (root.dataset.initialized === 'true') return;
      root.dataset.initialized = 'true';

      var output = root.querySelector('.ascii-output');
      if (!output) return;

      var isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent)
        || ('ontouchstart' in window)
        || (navigator.maxTouchPoints && navigator.maxTouchPoints > 2);

      var framePathList = JSON.parse(root.dataset.framePaths || '[]');
      var rafId = 0;

      function loadFrames(jsonPath) {
        return fetch(jsonPath)
          .then(function(res) {
            if (!res.ok) throw new Error('Failed to load ' + jsonPath);
            return res.json();
          });
      }

      function animateFrames(frames) {
        if (!frames || !frames.length) return false;

        var frameIndex = 0;
        var lastTime = 0;

        function renderFrame(time) {
          if (!frames.length) return;

          if (!lastTime) {
            lastTime = time;
            output.textContent = frames[frameIndex].ascii;
          }

          var currentFrame = frames[frameIndex];
          if (time - lastTime >= currentFrame.duration) {
            frameIndex = (frameIndex + 1) % frames.length;
            output.textContent = frames[frameIndex].ascii;
            lastTime = time;
          }

          rafId = window.requestAnimationFrame(renderFrame);
        }

        output.textContent = frames[0].ascii;
        rafId = window.requestAnimationFrame(renderFrame);
        return true;
      }

      function start() {
        if (rafId) {
          window.cancelAnimationFrame(rafId);
          rafId = 0;
        }

        var path = isMobile ? framePathList[0].mobile : framePathList[0].desktop;

        loadFrames(path)
          .then(function(frames) {
            if (!animateFrames(frames)) {
              output.textContent = 'ASCII unavailable';
            }
          })
          .catch(function() {
            output.textContent = 'ASCII unavailable';
          });
      }

      start();

      window.addEventListener('astro:before-swap', function() {
        if (rafId) {
          window.cancelAnimationFrame(rafId);
          rafId = 0;
        }
      }, { once: true });
    });
  })();
</script>

<style>
  .ascii-canvas-shell {
    width: var(--ascii-desktop-width);
    margin-inline: auto;
    padding: 0;
    overflow: hidden;
  }

  .ascii-output {
    min-height: var(--ascii-desktop-min-height);
    margin: 0;
    overflow: hidden;
    white-space: pre;
    font-family: 'IBM Plex Mono', monospace;
    font-size: var(--ascii-desktop-font-size);
    line-height: 0.86;
    letter-spacing: 0;
    color: rgba(36, 50, 65, 0.94);
    background: transparent;
    padding: 0;
    text-shadow: 0 0 1px rgba(255, 255, 255, 0.15);
    user-select: none;
    -webkit-user-select: none;
  }
</style>
