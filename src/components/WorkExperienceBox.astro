---
/**
 * =============================================================================
 * WORKEXPERIENCEBOX.ASTRO - PROFESSIONAL EXPERIENCE CONTAINER
 * =============================================================================
 *
 * PURPOSE:
 *   Container component that renders a vertical list of work experience
 *   entries. Each entry shows company, position, dates, and achievement
 *   bullet points.
 *
 * PORTFOLIO USE CASE:
 *   - Displays career history in the About section sidebar
 *   - Allows quick scanning of professional background
 *   - Entries have hover states for interactive feedback
 *
 * DATA FLOW:
 *   - Receives: workExperiences array from data.js
 *   - Renders: Maps each experience object to a WorkExperienceItem component
 *   - Each experience: { organisationName, position, date, info[] }
 *
 * SUB-COMPONENTS:
 *   - WorkExperienceItem: Individual experience entry with details
 *
 * MODIFICATION NOTES:
 *   - To change list layout: modify flex-col class
 *   - To change padding: modify p-1 class
 */

import WorkExperienceItem from './WorkExperienceItem.astro';

const { workExperiences = {} } = Astro.props;
---

<div class='flex flex-col p-1'>
  {
    workExperiences.map((workExperience) => (
      <WorkExperienceItem workExperience={workExperience} />
    ))
  }
</div>
