---
/**
 * =============================================================================
 * CONTACTBOXITEM.ASTRO - SOCIAL/CONTACT LINK ITEM
 * =============================================================================
 *
 * PURPOSE:
 *   Renders a single social or contact link as an interactive row with
 *   icon indicator. Used in the ContactSection to display available
 *   platforms for connecting with Salem.
 *
 * PORTFOLIO USE CASE:
 *   - Displays individual social media/professional links
 *   - Common platforms: GitHub, LinkedIn, Instagram, Twitter/X, WhatsApp
 *   - Entire row is clickable with hover animation
 *
 * PROPS:
 *   - contact: Object { name: string, link: string }
 *     - name: Display label (e.g., "GitHub")
 *     - link: URL to the profile/page
 *   - icon: string (optional) - Raw SVG HTML to render as the platform icon
 *
 * FEATURES:
 *   - Platform name displayed as clickable text
 *   - Custom SVG icon displayed (when provided)
 *   - Border animates from transparent to black on hover
 *
 * HOVER STATES:
 *   - Text color: text-slate-500 → text-black
 *   - Border: transparent → border-b-2 (black)
 *   - Font weight: normal → semibold
 *   - Icon color inherits text color transition
 *
 * MODIFICATION NOTES:
 *   - To add email link: use mailto: prefix (e.g., link: 'mailto:salem@example.com')
 *   - To add phone: similarly use tel: prefix
 *   - To change hover colors: modify text-slate-500 and hover:text-black
 */

const { contact, icon } = Astro.props;
---

<a
  href={contact.link}
  class='group cursor-pointer flex w-full p-5 items-center justify-between transition duration-300 text-slate-500 hover:text-black hover:font-semibold'
>
  <div class='flex items-center gap-3'>
    {icon && <span class='w-6 h-6' set:html={icon} />}
    <p>{contact.name}</p>
  </div>
</a>
