---
/**
 * =============================================================================
 * ABOUTSECTION.ASTRO - ABOUT ME + SKILLS SECTION
 * =============================================================================
 *
 * PURPOSE:
 *   The "About" section displaying extended biography and technical skills as
 *   pill badges. Layout mirrors MainSection: biography on left/top, skills on right/bottom.
 *
 * PORTFOLIO USE CASE:
 *   - Provides detailed background on Salem's skills
 *   - Skills displayed as rounded badges for quick scanning
 *
 * LAYOUT STRUCTURE:
 *   - Left/Top (60%): "About Me" heading + bio + "Skills" heading + skill badges
 *   - Anchor ID: 'about' enables navigation from navbar
 *
 * SUB-COMPONENTS:
 *   - Section: Wrapper component
 *   - SkillsBox: Container rendering individual skill badges
 *
 * DATA RECEIVED:
 *   - aboutMe: Extended biography text (string)
 *   - skills: Array of skill name strings
 *
 * SKILLS DISPLAY:
 *   - SkillsBox renders skills as rounded pill badges
 *   - Each badge: SkillItem component with bg-slate-100, centered text
 *
 * MODIFICATION NOTES:
 *   - To reorder sections within: modify the div structure and flex direction
 *   - To change skill badge style: modify SkillItem.astro
 */

import Section from '../Section.astro';
import SkillsBox from '../SkillsBox.astro';
import AsciiCanvas from '../AsciiCanvas.astro';
const { aboutMe, skills } = Astro.props;
---

<Section styles='p-8 md:p-16 overflow-hidden bg-gray-100' ids='about'>
  <div
    class='relative flex flex-col md:flex-row basis-0 gap-1 md:justify-between md:gap-[5rem] items-center w-full min-h-[85vh]'
  >
    <div class='box introduction relative z-10 w-[100%] md:w-[50%] md:ml-auto p-5'>
      <div class='box-text stagger-container'>
        <h3
          class='leading-[4rem] md:leading-[8rem] font-bold text-[4rem] md:text-[6rem] text-right animate-on-scroll'
        >
          About Me
        </h3>
        <p
          class='intro-bio mt-5 md:mt-8 mb-5 leading-6 md:leading-7 md:text-2xl text-slate-700 text-right animate-on-scroll'
        >
          {aboutMe}
        </p>
        <h3
          class='leading-[4rem] md:leading-[8rem] font-bold text-[2rem] md:text-[4rem] text-right animate-on-scroll w-full md:w-[50%] ml-auto'
        >
          Skills
        </h3>
        <SkillsBox skills={skills} />
      </div>
    </div>
    <div class='hidden md:flex absolute left-[4%] top-[10rem] lg:left-[5%] lg:top-[12rem] xl:left-[6%] px-2 md:px-0 animate-on-scroll justify-center pointer-events-none z-0 opacity-90'>
      <AsciiCanvas
        gifSources={['/gif/Cube-shape animation-3.gif']}
        desktopColumns={56}
        desktopWidth='min(100%, 42rem)'
        desktopMinHeight='30rem'
        desktopFontSize='clamp(0.52rem, 0.82vw, 0.74rem)'
      />
    </div>
  </div>
</Section>
