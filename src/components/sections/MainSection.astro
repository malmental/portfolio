---
/**
 * =============================================================================
 * MAINSECTION.ASTRO - HERO PRESENTATION SECTION
 * =============================================================================
 *
 * PURPOSE:
 *   The hero/introductory section of the portfolio homepage. Displays the
 *   portfolio owner's name as a large headline and a biography paragraph.
 *   Layout: side-by-side on desktop, stacked on mobile.
 *
 * PORTFOLIO USE CASE:
 *   - This is the FIRST thing visitors see - your visual introduction
 *   - The large typography with the name creates immediate identity
 *
 * LAYOUT STRUCTURE:
 *   - Left/Top: Name headline + bio paragraph
 *   - Responsive: stacks vertically on mobile, horizontal split on desktop
 *
 * SUB-COMPONENTS:
 *   - Navbar: React component for responsive navigation
 *   - Section: Wrapper providing consistent section styling
 *
 * DATA RECEIVED:
 *   - navLinks: Array of navigation link objects
 *   - myName: Portfolio owner name (string)
 *   - myBio: Introduction/bio paragraph (string)
 *
 * TYPOGRAPHY:
 *   - Name: 4rem mobile → 7rem XL desktop (bold, leading tight)
 *   - Bio: 1rem mobile → 1.5rem desktop (text-slate-700, text-justify)
 *
 * MODIFICATION NOTES:
 *   - To change hero background: modify Section wrapper classes
 *   - To adjust layout proportions: modify w-[60%] and w-[30%] percentages
 *   - To reorder: currently name/bio left (swap container order)
 */

import Navbar from '../Navbar';
import Section from '../Section.astro';
import AsciiCanvas from '../AsciiCanvas.astro';
const { navLinks, myName, myBio } = Astro.props;
---

<Section styles='p-1 overflow-hidden'>
  <Navbar navLinks={[]} client:load />
  <div
    class='relative mt-[3rem] md:mt-3 flex flex-col md:flex-row basis-0 gap-8 md:justify-between md:gap-0 items-center w-full min-h-[80vh] md:min-h-[88vh]'
  >
    <div class='introduction relative z-10 w-[100%] md:w-[50%] p-5'>
      <div class='intro-text-box'>
        <h2
          class='intro-text leading-[4rem] md:leading-[8rem] font-bold tracking-wider text-[4rem] md:text-[5rem] lg:text-[6rem] xl:text-[7rem] animate-on-scroll'
        >
          I'm {myName}.
        </h2>
      </div>
      <p
        class='intro-bio mt-5 md:mt-8 mb-5 leading-6 md:leading-7 md:text-2xl text-slate-700 text-justify animate-on-scroll'
      >
        {myBio}
      </p>
    </div>
    <div class='hidden md:flex absolute right-[2%] top-[8rem] lg:right-[3%] lg:top-[9rem] xl:right-[4%] xl:top-[10rem] px-2 md:px-0 animate-on-scroll justify-center pointer-events-none z-0 opacity-95'>
      <AsciiCanvas
        gifSources={['/gif/Cube-shape animation-2.gif']}
        desktopColumns={64}
        desktopWidth='min(100%, 52rem)'
        desktopMinHeight='36rem'
        desktopFontSize='clamp(0.62rem, 1vw, 0.88rem)'
      />
    </div>
  </div></Section
>
