---
/**
 * =============================================================================
 * MAINSECTION.ASTRO - HERO PRESENTATION SECTION
 * =============================================================================
 *
 * PURPOSE:
 *   The hero/introductory section of the portfolio homepage. Displays the
 *   portfolio owner's name as a large headline, a biography paragraph, and a
 *   sidebar featuring selected projects. Layout: side-by-side on desktop,
 *   stacked on mobile.
 *
 * PORTFOLIO USE CASE:
 *   - This is the FIRST thing visitors see - your visual introduction
 *   - The large typography with the name creates immediate identity
 *   - Featured projects sidebar provides quick access to key works
 *
 * LAYOUT STRUCTURE:
 *   - Left/Top (60%): Name headline + bio paragraph
 *   - Right/Bottom (30%): "Selected Projects" heading + project links
 *   - Responsive: stacks vertically on mobile, horizontal split on desktop
 *
 * SUB-COMPONENTS:
 *   - Navbar: React component for responsive navigation
 *   - Section: Wrapper providing consistent section styling
 *   - SelectedProjectBox: Container for project links
 *
 * DATA RECEIVED:
 *   - navLinks: Array of navigation link objects
 *   - myName: Portfolio owner name (string)
 *   - myBio: Introduction/bio paragraph (string)
 *   - selectedProjects: Array of project objects { name, link }
 *
 * TYPOGRAPHY:
 *   - Name: 4rem mobile → 7rem XL desktop (bold, leading tight)
 *   - Bio: 1rem mobile → 1.5rem desktop (text-slate-700, text-justify)
 *
 * MODIFICATION NOTES:
 *   - To change hero background: modify Section wrapper classes
 *   - To adjust layout proportions: modify w-[60%] and w-[30%] percentages
 *   - To reorder: currently name/bio left, projects right (swap container order)
 */

import Navbar from '../Navbar';
import Section from '../Section.astro';
import SelectedProjectBox from '../SelectedProjectBox.astro';
const { navLinks, myName, myBio, selectedProjects } = Astro.props;
---

<Section styles='p-1'>
  <Navbar navLinks={navLinks} client:load />
  <div
    class='mt-[3rem] md:mt-3 flex flex-col md:flex-row basis-0 gap-1 md:justify-between md:gap-[5rem] items-center w-full min-h-[80vh] md:min-h-[85vh]'
  >
    <div class='introduction w-[100%] md:w-[60%] p-5'>
      <div class='intro-text-box'>
        <h2
          class='intro-text leading-[4rem] md:leading-[8rem] font-bold text-[4rem] md:text-[5rem] lg:text-[6rem] xl:text-[7rem]'
        >
          I'm {myName}.
        </h2>
      </div>
      <p
        class='intro-bio mt-5 md:mt-8 mb-5 leading-6 md:leading-7 md:text-2xl text-slate-700 text-justify'
      >
        {myBio}
      </p>
    </div>
    <div
      class='projects w-[100%] md:w-[30%] md:mr-5 justify-start flex flex-col gap-5'
    >
      <h3 class='heading text-slate-600 uppercase font-semibold ml-4'>
        Selected Projects
      </h3>
      <SelectedProjectBox projects={selectedProjects} />
    </div>
  </div></Section
>
