---
/**
 * =============================================================================
 * BLOGSECTION.ASTRO - CURRENT PROJECTS / VIDEO PREVIEW SECTION
 * =============================================================================
 *
 * PURPOSE:
 *   Section showcasing current projects via short video previews.
 *   Displays Academy WebApp first with Try the app + screenshot, then video + text.
 *
 * PORTFOLIO USE CASE:
 *   - Academy WebApp: "Try the app!" CTA with screenshot, then video with description
 *   - Godot Game demos centered at the bottom
 *
 * LAYOUT STRUCTURE:
 *   1. Current Projects header
 *   2. "Try the app!" + Academy WebApp screenshot (text LEFT, image RIGHT)
 *   3. Academy WebApp video + text (video LEFT, text RIGHT)
 *   4. Godot Game centered
 */

import VideoItem from '../VideoItem.astro';
import ImageItem from '../ImageItem.astro';
import Section from '../Section.astro';
const { writingText } = Astro.props;

const webappProject = {
  videoSrc: '/videos/webapp-demo.mp4',
  title: 'Dashboard Web App',
  description: 'Full MVC Arquitecture made with PHP & Laravel.',
};

const godotProjects = [
  {
    videoSrc: '/videos/game-demo.mp4',
    title: 'Culto-Nocturo',
    description: 'A first person rouge-like shooter game. I haven`t been able to spend so much time working on it because of school but i`m still on it!.',
  },
  {
    videoSrc: '/videos/game-demo-2.mp4',
    title: 'Level desing and Movement with Godot Engine',
    description: 'Exploration of the character movement mechanics and physics interactions in the game environment. Btw, this is a free opensource platform, an increible tool!.',
  },
];
---

<Section styles='p-8 md:p-16 pt-12 pb-12' ids='blog'>
  <div class='stagger-container w-full max-w-screen-xl mx-auto px-1 py-3 md:p-5'>
    <h3
      class='max-w-[12ch] leading-[3.2rem] sm:leading-[3.8rem] md:leading-[8rem] font-bold text-[3.1rem] sm:text-[3.8rem] md:text-[6rem] animate-on-scroll mb-8 md:mb-10'
    >
      Current Projects
    </h3>
    <p
      class='intro-bio mt-8 md:mt-12 mb-12 md:mb-20 max-w-[42rem] leading-7 md:leading-7 text-base sm:text-lg md:text-2xl text-slate-700 text-left text-balance animate-on-scroll'
    >
      {writingText}
    </p>
    <div class='stagger-container w-full flex flex-col gap-10 md:gap-16'>
      <div class='w-full flex flex-col md:flex-row items-start md:items-center gap-6 md:gap-8'>
        <div class='animate-on-scroll w-full md:w-[50%] px-1 py-2 md:p-5 text-left'>
          <p class='max-w-[20ch] text-2xl md:text-4xl font-bold leading-tight text-slate-700 animate-on-scroll'>
        Try live the deployed app INCIDENsly 𝒘ebApp
          </p>
        </div>
        <div class='w-full md:w-[50%] px-1 py-2 md:p-5'>
          <a
            href='https://incidenslywebapp.vercel.app/'
            target='_blank'
            rel='noopener noreferrer'
            class='bg-white p-3 md:p-4 rounded-lg shadow-lg inline-block w-full screenshot-link'
          >
            <ImageItem
              imageSrc='/images/academy-screenshot-1.png'
              alt='Academy WebApp'
              caption='API REST made with PHP & Laravel'
            />
          </a>
        </div>
      </div>

      <div class='stagger-container w-full flex flex-col md:flex-row items-start md:items-center gap-6 md:gap-8'>
        <div class='w-full md:w-[50%] px-1 py-2 md:p-5'>
          <VideoItem
            videoSrc={webappProject.videoSrc}
            bordered={false}
          />
        </div>
        <div class='w-full md:w-[50%] px-1 py-2 md:p-5 text-left md:text-right'>
          <h4 class='font-bold text-3xl md:text-4xl mb-4 animate-on-scroll'>
            {webappProject.title}
          </h4>
          <p class='max-w-[34rem] md:ml-auto text-base md:text-xl text-slate-700 leading-relaxed animate-on-scroll'>
            {webappProject.description}
          </p>
        </div>
      </div>

      <div class='stagger-container w-full px-1 py-3 md:p-5 flex flex-col items-start md:items-center gap-8'>
        <h4 class='font-bold text-3xl md:text-4xl animate-on-scroll text-left md:text-center'>
          My WIP personal project
        </h4>
        <div class='stagger-container w-full flex flex-col md:flex-row gap-10 md:gap-14'>
          {godotProjects.map((project, index) => (
            <div class={`w-full md:w-[50%] ${index === 0 ? 'md:text-right' : 'md:text-left'}`}>
              <VideoItem
                videoSrc={project.videoSrc}
                title={project.title}
                description={project.description}
                bordered={false}
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</Section>
